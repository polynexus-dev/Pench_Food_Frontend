# ─────────────────────────────────────────────────────────────
# Pench Food Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must be created manually on each machine.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (without http:// or https:// prefix)
# The frontend automatically uses https:// in production.
# Examples:
#   Production : pench.api.polynexus.in/api
#   Local dev  : localhost:8000/api
VITE_API_URL=pench.api.polynexus.in/api
